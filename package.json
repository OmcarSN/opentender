{
  "name": "opentender-mst",
  "version": "1.0.0",
  "description": "Sealed-bid public tendering smart contract suite for MST Blockchain BUILDATHON #2",
  "scripts": {
    "dev": "npm --prefix dashboard run dev",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:mst": "hardhat run scripts/deploy.js --network mstTestnet",
    "seed": "hardhat run scripts/seed.js --network localhost",
    "demo": "hardhat run scripts/demo.js --network localhost",
    "demo:live": "hardhat run scripts/demo-live.js --network mstTestnet",
    "reset": "hardhat run scripts/reset.js --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "hardhat": "^2.22.3",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.11"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
